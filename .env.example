# Copy to .env.local and fill in. .env.local is gitignored and NEVER
# deploys — production reads its environment from Vercel project
# settings. So this file describes LOCAL development values.
#
# Do not run `vercel env pull` into .env.local unless the project's
# Development scope holds dev values. It overwrites this file with
# whatever Vercel has, and production values break local dev outright.

# ── Clerk ────────────────────────────────────────────────────────────
# MUST be the DEVELOPMENT instance (pk_test_/sk_test_). Production keys
# are domain-locked to mnsfantasy.com and refuse to initialize on
# localhost or on *.vercel.app previews — the app renders a blank page.
# Both keys must come from the SAME instance or every API call 401s.
# Dashboard → instance switcher → Development → API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# ── Database ─────────────────────────────────────────────────────────
# Point this at a Neon BRANCH for local work. The default production
# branch holds real pools, drafts and users.
DATABASE_URL=

# ── Live golf data (SlashGolf via RapidAPI) ──────────────────────────
RAPIDAPI_KEY=

# ── Platform / hub ───────────────────────────────────────────────────
# The hub hosts the shared draft service. Unset, the code falls back to
# https://mnsfantasy.com — meaning local draft testing mutates REAL
# drafts. Set it to your locally running hub when touching drafts.
PLATFORM_API_URL=http://localhost:3001

# Shared secret for golf → hub service calls. Must match the hub's value.
DRAFT_SERVICE_SECRET=

# Guards /api/cron/* and the manual settle endpoint.
CRON_SECRET=

# ── App URLs ─────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:3000
VITE_PLATFORM_URL=https://mnsfantasy.com

# ── Admin ────────────────────────────────────────────────────────────
# Comma-separated Clerk user IDs. Dev-instance IDs differ from
# production, so use the ID of the account you create locally.
ADMIN_USER_IDS=
